# =====================================================================
#  Project-root .htaccess
# =====================================================================
#
#  Only read when the project root itself is web-reachable — that is, a
#  subfolder install such as:
#
#      public_html/APL/   ->   https://deam.co.in/APL
#
#  With the recommended setup (document root pointed straight at public/)
#  Apache never reads this file and none of it applies.
#
#  It does two jobs:
#
#  1. Rewrites every request into public/, so the URL stays
#     /APL/score.php rather than /APL/public/score.php.
#
#  2. Keeps app/, config/, database/, storage/ and the dotfiles
#     unreachable.
#
#  Why the guards are NOT a blanket "Require all denied" here: Apache
#  evaluates authorization BEFORE mod_rewrite's per-directory fixup runs,
#  so a deny at this level would reject the request before the rewrite
#  ever happened, and the whole app would 403. The private directories
#  each carry their own .htaccess instead — those are authorization-phase
#  rules, so they hold whether or not mod_rewrite is available.
#
#  (An .htaccess only governs HTTP requests. PHP's own require of
#  config/config.php is filesystem access and is entirely unaffected.)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Refuse the private tree outright, before anything is rewritten.
    RewriteRule ^(app|config|database|storage|tests|deploy)(/|$) - [F,L]

    # Already inside public/ — stop. This is what prevents a rewrite loop.
    RewriteRule ^public/ - [L]

    # Everything else is served out of public/, invisibly.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# ---------------------------------------------------------------------
#  Authorization-phase guards. These apply even with mod_rewrite off.
# ---------------------------------------------------------------------

# .env, .htaccess, .cpanel.yml, .git remnants, editor droppings.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Source, data and docs that must never be served as text.
<FilesMatch "\.(sql|md|yml|yaml|lock|json|ini|log|bak|orig|swp|dist|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
