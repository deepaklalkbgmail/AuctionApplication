# Copy to .env  ->  cp .env.example .env
# .env lives OUTSIDE the web root and is git-ignored. Never commit real credentials.

APP_NAME="CricAuction"
APP_ENV=local              # local | production   (production hides errors, forces secure cookies)
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cric_auction
DB_USER=cric_app
DB_PASS=
DB_CHARSET=utf8mb4

# Auction defaults (also stored per-tournament in the DB)
AUCTION_TIMER_SECONDS=30
AUCTION_MIN_INCREMENT=500000
