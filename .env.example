# Copy to .env  ->  cp .env.example .env
# .env lives OUTSIDE the web root and is git-ignored. Never commit real credentials.

APP_NAME="CricAuction"
APP_ENV=local              # local | production   (production hides errors, forces secure cookies)
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------
#  Database — the ONLY place these values live.
#
#  Change them here and nowhere else: config/db.php reads this file, and no
#  PHP source contains a host, user or password. .env is git-ignored, so a
#  redeploy never overwrites the copy on the server.
#
#  On cPanel the account prefix (deamco_) is mandatory and is added by
#  cPanel itself — always use the full prefixed name shown in
#  MySQL® Databases. Names are case-sensitive on Linux: deamco_APL and
#  deamco_apl are different databases.
#
#  DB_HOST: use "localhost" on cPanel (MySQL socket). 127.0.0.1 forces a
#  TCP connection, which many shared hosts block.
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=deamco_APL
DB_USER=deamco_dpk

# Leave EMPTY here. Fill it in only in the real .env on the server.
# .env.example is committed to git — a password written here is published,
# and stays in the git history even after it is deleted.
DB_PASS=

DB_CHARSET=utf8mb4

# Auction defaults (also stored per-tournament in the DB)
AUCTION_TIMER_SECONDS=30
AUCTION_MIN_INCREMENT=500000
